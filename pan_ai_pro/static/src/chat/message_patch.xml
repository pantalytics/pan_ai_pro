<templates xml:space="preserve">
    <t t-name="pan_ai_pro.Message" t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-richBody')]" position="before">
            <div t-if="this.panAiStream" class="pan-ai-stream" aria-live="polite" aria-atomic="false">
                <t t-foreach="this.panAiStream.tools" t-as="tool" t-key="tool.id">
                    <div class="pan-ai-tool text-muted small d-flex align-items-center gap-1" t-att-aria-busy="tool.summary ? 'false' : 'true'">
                        <i class="fa fa-wrench" t-att-class="{ 'pan-ai-tool-busy': !tool.summary }" aria-hidden="true"/>
                        <span class="pan-ai-tool-name" t-out="tool.name"/>
                        <span t-if="tool.summary" class="pan-ai-tool-summary text-truncate" t-out="tool.summary"/>
                    </div>
                </t>
                <div t-if="this.panAiStream.text" class="pan-ai-text" t-out="this.panAiStream.text"/>
                <div t-elif="!this.panAiStream.tools.length and this.panAiStream.status === 'running'" class="pan-ai-thinking text-muted small" role="status">Thinking</div>
                <div t-if="this.panAiStream.pending.length" class="pan-ai-approval mt-2" role="group" aria-label="Approval needed">
                    <t t-foreach="this.panAiStream.pending" t-as="call" t-key="call.id">
                        <div class="pan-ai-approval-card border border-warning rounded p-2 mb-1">
                            <div class="small">The agent wants to run <b t-out="call.name"/></div>
                            <pre class="pan-ai-approval-args small text-muted mb-1" t-out="call.args"/>
                            <div t-if="!this.panAiIsDecided(call)" class="d-flex gap-1">
                                <button class="btn btn-primary btn-sm pan-ai-approve" t-on-click="() => this.panAiApprove(call, true)" t-att-aria-label="'Allow ' + call.name">Allow</button>
                                <button class="btn btn-secondary btn-sm pan-ai-skip" t-on-click="() => this.panAiApprove(call, false)" t-att-aria-label="'Skip ' + call.name">Skip</button>
                            </div>
                            <div t-else="" class="small text-muted">Decided</div>
                        </div>
                    </t>
                </div>
                <div t-if="this.panAiStream.error" class="pan-ai-error text-danger small mt-1" role="alert" t-out="this.panAiStream.error"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o-mail-Message-richBody')]" position="attributes">
            <attribute name="t-elif">this.message.hasTextContent and this.message.richBody and !this.message.linkPreviewSquash and !this.panAiStream</attribute>
        </xpath>
    </t>
</templates>
