        <field name="model_name">anthropic/claude-opus-5-5</field>
        <field name="sequence">25</field>
        <field name="recommended" eval="True"/>
    </record>
    <record id="model_eu_gpt_sol" model="pan_ai.model">
        <field name="name">GPT Sol</field>
        <field name="host">eurouter</field>
        <field name="model_name">openai/gpt-6.1-sol</field>
        <field name="sequence">26</field>
        <field name="recommended" eval="True"/>
    </record>
    <record id="model_eu_gpt_luna" model="pan_ai.model">
        <field name="name">GPT Luna</field>
        <field name="host">eurouter</field>
        <field name="model_name">openai/gpt-6-luna</field>
        <field name="sequence">27</field>
        <field name="recommended" eval="True"/>
    </record>
</odoo>
