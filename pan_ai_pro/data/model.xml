<odoo noupdate="1">
    <!-- The three families spike S5 measured through OpenRouter. -->
    <record id="model_claude_sonnet" model="pan_ai.model">
        <field name="name">Claude Sonnet 5.5</field>
        <field name="model_name">anthropic/claude-sonnet-5.5</field>
        <field name="sequence">1</field>
    </record>
    <record id="model_gpt" model="pan_ai.model">
        <field name="name">GPT 5.6</field>
        <field name="model_name">openai/gpt-5.6-terra</field>
        <field name="sequence">2</field>
    </record>
    <record id="model_gemini_flash" model="pan_ai.model">
        <field name="name">Gemini 3.8 Flash</field>
        <field name="model_name">google/gemini-3.8-flash</field>
        <field name="sequence">3</field>
    </record>
</odoo>
