<odoo>
    <record id="view_run_list" model="ir.ui.view">
        <field name="name">pan_ai.run.list</field>
        <field name="model">pan_ai.run</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="started_at"/>
                <field name="kind"/>
                <field name="agent_id"/>
                <field name="user_id"/>
                <field name="status" widget="badge" decoration-success="status == 'ok'" decoration-danger="status == 'failed'" decoration-warning="status == 'interrupted'"/>
                <field name="slices" optional="hide"/>
                <field name="requests"/>
                <field name="input_tokens" optional="hide"/>
                <field name="output_tokens" optional="hide"/>
                <field name="cost" sum="Cost"/>
                <field name="duration" string="Seconds" digits="[16, 1]"/>
                <field name="error" optional="show"/>
                <button name="action_stop" type="object" string="Stop" icon="fa-stop" invisible="status not in ('running', 'interrupted')"/>
            </list>
        </field>
    </record>
    <record id="view_run_form" model="ir.ui.view">
        <field name="name">pan_ai.run.form</field>
        <field name="model">pan_ai.run</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_stop" type="object" string="Stop" invisible="status not in ('running', 'interrupted')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="thread_id"/>
                            <field name="agent_id"/>
                            <field name="kind"/>
                            <field name="user_id"/>
                            <field name="caller_id"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="slices"/>
                            <field name="requests"/>
                            <field name="input_tokens"/>
                            <field name="output_tokens"/>
                            <field name="cost"/>
                            <field name="worker" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <field name="error" invisible="not error"/>
                    <notebook>
                        <page string="Answer" name="answer"><field name="text_html" nolabel="1" readonly="1"/></page>
                        <page string="Tool calls" name="tools"><field name="tool_log" nolabel="1" readonly="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Silent when healthy: Runs opens on what needs a look. -->
    <record id="view_run_search" model="ir.ui.view">
        <field name="name">pan_ai.run.search</field>
        <field name="model">pan_ai.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id"/>
                <field name="user_id"/>
                <filter name="attention" string="Needs a look" domain="[('status', 'in', ('failed', 'running', 'interrupted'))]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('started_at', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="by_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_run" model="ir.actions.act_window">
        <field name="name">Activity</field>
        <field name="res_model">pan_ai.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_run_search"/>
        <field name="context">{'search_default_attention': 1}</field>
        <field name="help" type="html">
            <p>A run is one question to one answer. Nothing needs a look; remove the filter to see them all.</p>
        </field>
    </record>
</odoo>
