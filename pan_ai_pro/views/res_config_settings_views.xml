<odoo>
    <!-- Settings > AI Pro. A setup checklist on top, the same shape as Mail
         Pro's: one line per step, a dot for where it stands, its name, the
         answer, and under it what to do. Below it only About, the version.
         The limits keep their defaults, the MCP allow list sits on the tool
         group, removing the key sits with the key. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pan_ai_pro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Pro" string="AI Pro" name="pan_ai_pro" groups="base.group_system"
                     logo="/pan_ai_pro/static/description/icon.png">
                    <field name="pan_ai_state" invisible="1"/>
                    <field name="pan_ai_entitled" invisible="1"/>
                    <field name="pan_ai_has_key" invisible="1"/>
                    <field name="pan_ai_has_chatted" invisible="1"/>

                    <block title="Setup" name="pan_ai_setup_block">
                    <div class="col-12 o_setting_box o_pan_ai_steps">

                    <!-- Step 1. One action per state. Amber while it waits
                         for the person, red once a connection broke. -->
                    <div class="o_pan_ai_step">
                        <span class="o_pan_ai_dot o_pan_ai_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="not pan_ai_entitled"/>
                        <span class="o_pan_ai_dot o_pan_ai_dot_wait" role="img" aria-label="Needs you" title="Needs you"
                              invisible="pan_ai_entitled or pan_ai_state not in ('pending', 'connected')"/>
                        <span class="o_pan_ai_dot o_pan_ai_dot_broken" role="img" aria-label="Broken" title="Broken"
                              invisible="pan_ai_state != 'broken'"/>
                        <span class="o_pan_ai_dot o_pan_ai_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="pan_ai_state != 'not_connected'"/>
                        <div class="o_pan_ai_step_body">
                            <div class="o_pan_ai_step_head">
                                <span class="o_pan_ai_step_name">1. Pantalytics account</span>
                                <span class="o_pan_ai_step_value" invisible="pan_ai_state != 'not_connected'">Not connected</span>
                                <span class="o_pan_ai_step_value" invisible="pan_ai_state != 'pending'">Waiting for approval</span>
                                <span class="o_pan_ai_step_value" invisible="not pan_ai_entitled">Connected</span>
                                <span class="o_pan_ai_step_value" invisible="pan_ai_entitled or pan_ai_state != 'connected'">No plan</span>
                                <span class="o_pan_ai_step_value" invisible="pan_ai_state != 'broken'">
                                    <field name="pan_ai_link_status" nolabel="1" readonly="1" class="d-inline"/>
                                </span>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_state not in ('not_connected', 'broken')">
                                AI Pro runs on an Odoo instance that is connected to a Pantalytics account.
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_state != 'broken' or not pan_ai_message">
                                <field name="pan_ai_message" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_state not in ('not_connected', 'broken')">
                                <button name="action_pan_ai_connect" type="object"
                                        string="Connect to Pantalytics" class="btn-primary"/>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_state != 'pending'">
                                Approve the connection in the Pantalytics tab that just opened. It shows this code:
                                <field name="pan_ai_user_code" nolabel="1" readonly="1" class="fw-bold d-inline ms-1"/>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_state != 'pending'">
                                No tab? <field name="pan_ai_verify_url" widget="url" nolabel="1" readonly="1"
                                               options="{'website_path': False}" text="Open it again" class="d-inline"/>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_state != 'pending'">
                                <button name="action_pan_ai_check" type="object" string="Check approval" class="btn-primary"/>
                                <button name="action_pan_ai_disconnect" type="object" string="Cancel" class="btn-link"/>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_entitled or pan_ai_state != 'connected'">
                                <field name="pan_ai_why_not" nolabel="1" readonly="1"/>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_entitled or pan_ai_state != 'connected'">
                                <button name="action_pan_ai_check" type="object" string="Check again" class="btn-secondary"/>
                            </div>
                            <div class="o_pan_ai_step_msg text-muted" invisible="not pan_ai_entitled or not pan_ai_connected_by">
                                By <field name="pan_ai_connected_by" nolabel="1" readonly="1" class="d-inline"/>
                                <span invisible="not pan_ai_update_available">. Version
                                    <field name="pan_ai_update_available" nolabel="1" readonly="1" class="d-inline"/> is available.</span>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_state != 'connected'">
                                <button name="action_pan_ai_disconnect" type="object" string="Disconnect" class="btn-secondary"
                                        confirm="Disconnect this Odoo from Pantalytics? Agents stop until you connect it again."/>
                            </div>
                            <div class="o_pan_ai_step_msg o_pan_ai_msg_warn" invisible="not pan_ai_last_error">
                                <field name="pan_ai_last_error" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Nothing below exists until step 1 is done: a step you
                         cannot finish reads as the thing that is broken. -->
                    <div invisible="not pan_ai_entitled">

                    <!-- Step 2. Mail Pro's shape: nothing is typed on this
                         page, the arrow opens the dialog with the key. Models
                         are picked per agent, from AI Pro > Configuration > Models. -->
                    <div class="o_pan_ai_step">
                        <span class="o_pan_ai_dot o_pan_ai_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="not pan_ai_has_key"/>
                        <span class="o_pan_ai_dot o_pan_ai_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="pan_ai_has_key"/>
                        <div class="o_pan_ai_step_body">
                            <div class="o_pan_ai_step_head">
                                <span class="o_pan_ai_step_name">2. OpenRouter key</span>
                                <span class="o_pan_ai_step_value" invisible="pan_ai_has_key">No key</span>
                                <span class="o_pan_ai_step_value" invisible="not pan_ai_has_key">
                                    Ends in <field name="pan_ai_key_last4" nolabel="1" readonly="1" class="d-inline"/>
                                </span>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_has_key">
                                One key for every model. Create one at
                                <a href="https://openrouter.ai/keys" target="_blank" rel="noopener">openrouter.ai/keys</a>
                                and add it with the arrow.
                            </div>
                        </div>
                        <button name="action_pan_ai_openrouter" type="object"
                                icon="oi-arrow-right" title="OpenRouter key"
                                class="oe_link o_pan_ai_step_edit"/>
                    </div>

                    <!-- Step 3. A finished chat proves the account, the key
                         and the model in one go. -->
                    <div class="o_pan_ai_step">
                        <span class="o_pan_ai_dot o_pan_ai_dot_ok" role="img" aria-label="Done" title="Done"
                              invisible="not pan_ai_has_chatted"/>
                        <span class="o_pan_ai_dot o_pan_ai_dot_todo" role="img" aria-label="To do" title="To do"
                              invisible="pan_ai_has_chatted"/>
                        <div class="o_pan_ai_step_body">
                            <div class="o_pan_ai_step_head">
                                <span class="o_pan_ai_step_name">3. First chat</span>
                                <span class="o_pan_ai_step_value" invisible="pan_ai_has_chatted">Not yet</span>
                                <span class="o_pan_ai_step_value" invisible="not pan_ai_has_chatted">Done</span>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_has_chatted or not pan_ai_has_key">
                                Ask the agent something, like how many contacts there are.
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_has_chatted or not pan_ai_has_key">
                                <button name="action_pan_ai_open_chat" type="object" string="Open chat" class="btn-primary"/>
                            </div>
                            <div class="o_pan_ai_step_msg" invisible="pan_ai_has_key">
                                Save a key first.
                            </div>
                        </div>
                    </div>

                    </div>
                    </div>
                    </block>

                    <!-- About: the version the database is on, the first thing
                         a support mail asks, and on screen before step 1 too. -->
                    <block title="About" name="pan_ai_about_block">
                        <setting id="pan_ai_version_setting" string="AI Pro"
                                 help="© Pantalytics B.V. Licensed under the Elastic License 2.0.">
                            <field name="pan_ai_version" readonly="1"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

    <!-- Step 2's dialog: the same settings record, one field. Save runs
         the page's own execute, so the key goes where it always went. -->
    <record id="res_config_settings_view_openrouter" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pan_ai_pro.openrouter</field>
        <field name="model">res.config.settings</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="OpenRouter key">
                <field name="pan_ai_has_key" invisible="1"/>
                <div class="text-muted mb-2" invisible="not pan_ai_has_key">
                    The saved key ends in <field name="pan_ai_key_last4" readonly="1" class="d-inline"/>.
                    Paste a new one only to replace it.
                </div>
                <group>
                    <field name="pan_ai_new_key" string="Key" password="True"
                           placeholder="Paste a key from openrouter.ai/keys"/>
                </group>
                <footer>
                    <button name="execute" type="object" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Discard"/>
                    <button name="action_pan_ai_remove_key" type="object" string="Remove key"
                            class="btn-secondary ms-auto" invisible="not pan_ai_has_key"
                            confirm="Remove the OpenRouter key? Every agent stops at once until a new key is saved."/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
