<odoo>
    <!-- Edited in the list: a form would be a page for three fields. -->
    <record id="view_model_list" model="ir.ui.view">
        <field name="name">pan_ai.model.list</field>
        <field name="model">pan_ai.model</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence, name">
                <field name="sequence" widget="handle"/>
                <field name="name" placeholder="Claude Sonnet"/>
                <field name="host"/>
                <field name="model_name" placeholder="~anthropic/claude-sonnet-latest"/>
                <field name="agent_count"/>
                <field name="recommended" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- The agent's picker is Odoo's own record dialog, opened on the
         Recommended filter (static/src/agent/pick_model.js). Its list is
         this one: a name and an id to pick from, no handle and no toggles. -->
    <record id="view_model_pick" model="ir.ui.view">
        <field name="name">pan_ai.model.pick</field>
        <field name="model">pan_ai.model</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list default_order="sequence, name">
                <field name="name"/>
                <field name="host"/>
                <field name="model_name"/>
            </list>
        </field>
    </record>
    <record id="view_model_search" model="ir.ui.view">
        <field name="name">pan_ai.model.search</field>
        <field name="model">pan_ai.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_name"/>
                <filter name="recommended" string="Recommended" domain="[('recommended', '=', True)]"/>
                <separator/>
                <filter name="openrouter" string="OpenRouter" domain="[('host', '=', 'openrouter')]"/>
                <filter name="eurouter" string="EUrouter" domain="[('host', '=', 'eurouter')]"/>
                <group>
                    <filter name="group_host" string="Host" context="{'group_by': 'host'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">pan_ai.model</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>No models yet. Add one by its host's id; the ids are on <a href="https://openrouter.ai/models" target="_blank" rel="noopener">openrouter.ai/models</a> and <a href="https://www.eurouter.ai/models" target="_blank" rel="noopener">eurouter.ai/models</a>.</p>
        </field>
    </record>
</odoo>
