<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_server_action_form_ai" model="ir.ui.view">
        <field name="name">ir.actions.server.form.pan_ai</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="pan_ai_agent_id" invisible="state != 'pan_ai_run'" required="state == 'pan_ai_run'"/>
                <field name="pan_ai_prompt" invisible="state != 'pan_ai_run'" required="state == 'pan_ai_run'"
                       placeholder="What to do. {{ object.display_name }} and other fields of the record are filled in."/>
                <field name="pan_ai_post" invisible="state != 'pan_ai_run'"/>
                <field name="pan_ai_activity" invisible="state != 'pan_ai_run'"/>
            </xpath>
        </field>
    </record>
</odoo>
