<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_server_action_form_ai" model="ir.ui.view">
        <field name="name">ir.actions.server.form.pan_ai</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <!-- A group of its own, after the base form's warning, so the
                 fields get their labels (the state field sits in a flex div). -->
            <xpath expr="//div[@invisible='not warning']" position="after">
                <group string="AI agent" name="pan_ai" invisible="state != 'pan_ai_run'">
                    <field name="pan_ai_agent_id" required="state == 'pan_ai_run'"/>
                    <field name="pan_ai_prompt" required="state == 'pan_ai_run'"
                           placeholder="What to do. {{ object.display_name }} and other fields of the record are filled in."/>
                    <field name="pan_ai_post"/>
                    <field name="pan_ai_activity"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
