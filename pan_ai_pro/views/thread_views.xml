<odoo>
    <record id="view_thread_list" model="ir.ui.view">
        <field name="name">pan_ai.thread.list</field>
        <field name="model">pan_ai.thread</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="kind"/>
                <field name="agent_id"/>
                <field name="user_id"/>
                <field name="last_activity"/>
                <field name="run_count" string="Runs"/>
                <field name="cost" sum="Cost"/>
                <field name="paused" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_thread_form" model="ir.ui.view">
        <field name="name">pan_ai.thread.form</field>
        <field name="model">pan_ai.thread</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_open_chat" type="object" string="Open chat" class="btn-primary" invisible="not channel_id"/>
                    <button name="action_pause" type="object" string="Pause" invisible="kind != 'continuous' or paused"/>
                    <button name="action_resume" type="object" string="Resume" invisible="kind != 'continuous' or not paused"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="kind" readonly="1"/>
                            <field name="agent_id"/>
                            <field name="user_id"/>
                            <field name="channel_id" invisible="not channel_id" readonly="1"/>
                            <field name="res_model" invisible="not res_model"/>
                            <field name="res_id" invisible="not res_model"/>
                        </group>
                        <group>
                            <field name="last_activity" readonly="1"/>
                            <field name="usage_requests" readonly="1"/>
                            <field name="usage_input_tokens" readonly="1"/>
                            <field name="usage_output_tokens" readonly="1"/>
                            <field name="cost" readonly="1"/>
                        </group>
                    </group>
                    <group string="Records to watch" invisible="kind != 'continuous'">
                        <field name="watch_model_id"/>
                        <field name="watch_model" invisible="1"/>
                        <field name="watch_domain" widget="domain" options="{'model': 'watch_model'}"/>
                        <field name="watch_interval"/>
                        <field name="watch_cursor" readonly="1"/>
                        <field name="next_tick_at" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Activity" name="runs">
                            <field name="run_ids" nolabel="1" readonly="1" string="Run">
                                <list create="false" edit="false">
                                    <field name="started_at"/>
                                    <field name="kind"/>
                                    <field name="status"/>
                                    <field name="slices"/>
                                    <field name="requests"/>
                                    <field name="cost"/>
                                    <field name="duration" string="Seconds" digits="[16, 1]"/>
                                    <field name="error"/>
                                </list>
                            </field>
                        </page>
                        <page string="Messages" name="conversation" groups="pan_ai_pro.group_manager">
                            <field name="conversation" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_thread" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="res_model">pan_ai.thread</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>A conversation is everything said with an agent about one subject. None yet.</p>
        </field>
    </record>
</odoo>
